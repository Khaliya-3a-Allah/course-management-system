# Backend server settings
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
ENABLE_REQUEST_LOGS=true

# MongoDB (Member 2) — replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT (Member 2) — use a long, random secret in production
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d
JWT_CHALLENGE_EXPIRES_IN=5m

# Certificate Signing (Member 2) — use a long, random secret in production
CERTIFICATE_SIGNING_SECRET=your_certificate_signing_secret_key_change_this

# TOTP issuer label shown in authenticator apps
TOTP_ISSUER=Coursewave

# SMTP settings for email verification and password reset emails
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_password
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false

# Gemini AI recommendations
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Frontend env template — copy to .env.local (never commit .env.local)
# Vite exposes only variables prefixed with VITE_ to the client bundle.

# Local dev: point at the Express server started via `npm run dev:server`
VITE_API_URL=http://localhost:5000/api/v1

# Backend local env
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
CERTIFICATE_SIGNING_SECRET=replace_with_a_long_random_secret
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_PASS=your_gmail_app_password
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Production: the deployed Render backend
# VITE_API_URL=https://course-management-system-fluu.onrender.com/api/v1
